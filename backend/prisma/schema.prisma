generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  HR_ADMIN
  DEPARTMENT_HEAD
  EMPLOYEE
  RECRUITER
  CANDIDATE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MATERNITY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollStatus {
  PENDING
  PAID
  CANCELLED
}

enum DeviceType {
  HIKVISION
  ZKTECO
  ANVIZ
  HANVON
  OTHER
}

enum VacancyStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

enum CandidatePipelineStage {
  APPLIED
  SCREENING
  INTERVIEW
  TEST_TASK
  OFFER
  HIRED
  REJECTED
}

enum OnboardingStage {
  DAY_1
  WEEK_1
  MONTH_1
  MONTH_3
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum EventType {
  ONLINE
  OFFLINE
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  role      Role      @default(EMPLOYEE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  employee  Employee?
  notifications Notification[]
deviceTokens  UserDeviceToken[]
}

model Department {
  id                  String               @id @default(uuid())
  name                String
  parentId            String?
  parent              Department?          @relation("SubDepartments", fields: [parentId], references: [id])
  children            Department[]         @relation("SubDepartments")
  employees           Employee[]
  geofences           GeofenceZone[]
  jobVacancies        JobVacancy[]
  onboardingTemplates OnboardingTemplate[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  objectives Objective[]
}

model Position {
  id        String     @id @default(uuid())
  title     String
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Employee {
  id                  String                  @id @default(uuid())
  userId              String                  @unique
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName           String
  lastName            String
  leaveBalance        Float                   @default(20.0)
  departmentId        String?
  department          Department?             @relation(fields: [departmentId], references: [id])
  positionId          String?
  position            Position?               @relation(fields: [positionId], references: [id])
  managerId           String?
  manager             Employee?               @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates        Employee[]              @relation("EmployeeManager")
  attendances         Attendance[]
  leaveRequests       LeaveRequest[]
  payrolls            Payroll[]
  performanceReviews  PerformanceReview[]
  onboarding          EmployeeOnboarding?     @relation("EmployeeOnboardingRelation")
  mentoredOnboardings EmployeeOnboarding[]    @relation("MentorRelation")
  policySignatures    PolicySignature[]
  courseProgresses    CourseProgress[]
  certificates        CourseCertificate[]
  eventRegistrations  EventRegistration[]
  historyLogs         OrgStructureHistory[]   @relation("EmployeeHistory")
  changesMade         OrgStructureHistory[]   @relation("ChangedByHistory")
  lifecycleEvents     EmployeeLifecycleEvent[]
  offboarding         OffboardingRequest?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  lifecycleChecklists EmployeeLifecycleChecklist[]
  objectives Objective[]
  discAssessments DiscAssessment[]
  feedbackTargets   FeedbackAssignment[] @relation("FeedbackTarget")
feedbackReviewers FeedbackAssignment[] @relation("FeedbackReviewer")
gradeId           String?
grade             JobGrade?          @relation(fields: [gradeId], references: [id])
promotions        PromotionRequest[] @relation("EmployeePromotion")
careerHistories   CareerHistory[]
}

model Attendance {
  id                String           @id @default(uuid())
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date              DateTime         @db.Date
  checkIn           DateTime?
  checkOut          DateTime?
  checkInLat        Float?
  checkInLng        Float?
  checkInAddress    String?
  checkOutLat       Float?
  checkOutLng       Float?
  checkOutAddress   String?
  isOutsideGeofence Boolean          @default(false)
  isSpoofed         Boolean          @default(false)
  status            AttendanceStatus @default(PRESENT)
  note              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([employeeId, date])
}

model GeofenceZone {
  id           String      @id @default(uuid())
  name         String
  latitude     Float
  longitude    Float
  radius       Float       @default(100.0)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model LeaveRequest {
  id         String      @id @default(uuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       LeaveType
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  reason     String
  status     LeaveStatus @default(PENDING)
  approvedBy String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Payroll {
  id         String        @id @default(uuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month      Int
  year       Int
  baseSalary Float
  bonus      Float         @default(0)
  deductions Float         @default(0)
  netSalary  Float
  status     PayrollStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([employeeId, month, year])
}

model PerformanceReview {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId String
  score      Float
  feedback   String
  period     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DeviceLog {
  id         String     @id @default(uuid())
  deviceType DeviceType
  deviceId   String?
  rawPayload Json
  createdAt  DateTime   @default(now())
}

model JobVacancy {
  id             String           @id @default(uuid())
  title          String
  description    String
  requirements   String
  status         VacancyStatus    @default(OPEN)
  departmentId   String?
  department     Department?      @relation(fields: [departmentId], references: [id])
  candidates     Candidate[]
  vacancyMatches CandidateMatch[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Candidate {
  id               String                 @id @default(uuid())
  fullName         String
  email            String
  phone            String
  resumeUrl        String
  parsedSkills     String[]
  source           String                 @default("DIRECT")
  stage            CandidatePipelineStage @default(APPLIED)
  primaryVacancyId String?
  primaryVacancy   JobVacancy?            @relation(fields: [primaryVacancyId], references: [id])
  vacancyMatches   CandidateMatch[]
  feedbacks        CandidateFeedback[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model CandidateMatch {
  id          String     @id @default(uuid())
  candidateId String
  candidate   Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  vacancyId   String
  vacancy     JobVacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  matchScore  Float
  aiReason    String?
  createdAt   DateTime   @default(now())

  @@unique([candidateId, vacancyId])
}

model CandidateFeedback {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  reviewerId  String
  score       Float
  comment     String
  createdAt   DateTime  @default(now())
}

model OnboardingTemplate {
  id           String             @id @default(uuid())
  title        String
  description  String?
  departmentId String?
  department   Department?        @relation(fields: [departmentId], references: [id])
  tasks        OnboardingTask[]
  courses      OnboardingCourse[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model OnboardingTask {
  id               String                   @id @default(uuid())
  templateId       String
  template         OnboardingTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  stage            OnboardingStage          @default(DAY_1)
  assignedEmployee EmployeeOnboardingTask[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
}

model EmployeeOnboarding {
  id         String                   @id @default(uuid())
  employeeId String                   @unique
  employee   Employee                 @relation("EmployeeOnboardingRelation", fields: [employeeId], references: [id], onDelete: Cascade)
  mentorId   String?
  mentor     Employee?                @relation("MentorRelation", fields: [mentorId], references: [id])
  status     TaskStatus               @default(IN_PROGRESS)
  tasks      EmployeeOnboardingTask[]
  courses    EmployeeOnboardingCourse[]
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
}

model EmployeeOnboardingTask {
  id           String             @id @default(uuid())
  onboardingId String
  onboarding   EmployeeOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  taskId       String
  task         OnboardingTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status       TaskStatus         @default(PENDING)
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([onboardingId, taskId])
}

model OnboardingCourse {
  id          String                     @id @default(uuid())
  templateId  String
  template    OnboardingTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  videoUrl    String
  description String?
  enrollments EmployeeOnboardingCourse[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
}

model EmployeeOnboardingCourse {
  id           String             @id @default(uuid())
  onboardingId String
  onboarding   EmployeeOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  courseId     String
  course       OnboardingCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  isCompleted  Boolean            @default(false)
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([onboardingId, courseId])
}

model CompanyPolicy {
  id          String            @id @default(uuid())
  title       String
  description String?
  content     String?           @db.Text
  documentUrl String
  version     Int               @default(1)
  isRequired  Boolean           @default(true)
  parentId    String?
  parent      CompanyPolicy?    @relation("SubPolicies", fields: [parentId], references: [id])
  children    CompanyPolicy[]   @relation("SubPolicies")
  signatures  PolicySignature[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model PolicySignature {
  id            String        @id @default(uuid())
  policyId      String
  policy        CompanyPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  signedVersion Int           @default(1)
  signedAt      DateTime      @default(now())

  @@unique([policyId, employeeId])
}

model AcademyCategory {
  id          String          @id @default(uuid())
  name        String
  description String?
  courses     AcademyCourse[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model AcademyCourse {
  id           String              @id @default(uuid())
  categoryId   String?
  category     AcademyCategory?    @relation(fields: [categoryId], references: [id])
  title        String
  description  String?
  coverUrl     String?
  isRequired   Boolean             @default(false)
  lessons      AcademyLesson[]
  quizzes      AcademyQuiz[]
  resources    AcademyResource[]
  progress     CourseProgress[]
  certificates CourseCertificate[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model AcademyLesson {
  id        String        @id @default(uuid())
  courseId  String
  course    AcademyCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  videoUrl  String
  content   String?
  order     Int           @default(1)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model AcademyResource {
  id        String        @id @default(uuid())
  courseId  String
  course    AcademyCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  fileUrl   String
  fileType  String
  createdAt DateTime      @default(now())
}

model AcademyQuiz {
  id        String        @id @default(uuid())
  courseId  String
  course    AcademyCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  question  String
  options   String[]
  answer    Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model CourseProgress {
  id          String        @id @default(uuid())
  courseId    String
  course      AcademyCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  isCompleted Boolean       @default(false)
  quizScore   Float?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([courseId, employeeId])
}

model CourseCertificate {
  id                String        @id @default(uuid())
  courseId          String
  course            AcademyCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  certificateNumber String        @unique
  issuedAt          DateTime      @default(now())

  @@unique([courseId, employeeId])
}

model TrainingEvent {
  id            String              @id @default(uuid())
  title         String
  description   String?
  eventType     EventType           @default(ONLINE)
  locationOrUrl String
  eventDate     DateTime
  capacity      Int                 @default(20)
  registrations EventRegistration[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model EventRegistration {
  id           String        @id @default(uuid())
  eventId      String
  event        TrainingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  registeredAt DateTime      @default(now())

  @@unique([eventId, employeeId])
}
model OrgStructureHistory {
  id              String   @id @default(uuid())
  employeeId      String
  employee        Employee @relation("EmployeeHistory", fields: [employeeId], references: [id], onDelete: Cascade)
  oldDepartmentId String?
  newDepartmentId String?
  oldPositionId   String?
  newPositionId   String?
  oldManagerId    String?
  newManagerId    String?
  changedById     String
  changedBy       Employee @relation("ChangedByHistory", fields: [changedById], references: [id], onDelete: Cascade)
  reason          String?
  createdAt       DateTime @default(now())
}
enum LifecycleEventType {
  VACANCY_CREATED
  CANDIDATE_APPLIED
  OFFER_ACCEPTED
  HIRED
  ONBOARDING_STARTED
  ONBOARDING_COMPLETED
  PROBATION_PASSED
  PROMOTED
  DEPARTMENT_CHANGED
  COURSE_COMPLETED
  CERTIFICATE_EARNED
  PERFORMANCE_REVIEWED
  OFFBOARDING_STARTED
  EXIT_INTERVIEW_COMPLETED
  TERMINATED
}

model EmployeeLifecycleEvent {
  id          String             @id @default(uuid())
  employeeId  String
  employee    Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  eventType   LifecycleEventType
  title       String
  description String?
  eventDate   DateTime           @default(now())
  metadata    Json?
  createdAt   DateTime           @default(now())
}

model OffboardingRequest {
  id                 String                @id @default(uuid())
  employeeId         String                @unique
  employee           Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reason             String
  lastWorkingDay     DateTime              @db.Date
  exitInterviewNotes String?               @db.Text
  isAssetsReturned   Boolean               @default(false)
  status             TaskStatus            @default(IN_PROGRESS)
  tasks              OffboardingTaskItem[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}
enum LifecycleStage {
  PRE_HIRE
  ONBOARDING
  PROBATION
  REGULAR_WORK
  PROMOTION
  OFFBOARDING
}

model LifecycleTemplate {
  id          String                  @id @default(uuid())
  title       String
  description String?
  stage       LifecycleStage          @default(ONBOARDING)
  tasks       LifecycleTemplateTask[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model LifecycleTemplateTask {
  id          String                   @id @default(uuid())
  templateId  String
  template    LifecycleTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDays     Int                      @default(1)
  assignments EmployeeLifecycleChecklist[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
}

model EmployeeLifecycleChecklist {
  id          String                @id @default(uuid())
  employeeId  String
  employee    Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  taskId      String
  task        LifecycleTemplateTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  dueDate     DateTime
  status      TaskStatus            @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([employeeId, taskId])
}
enum OffboardingTaskCategory {
  IT_ACCESS
  ASSET_RETURN
  FINANCE
  HR_DOCUMENTS
}

model OffboardingTaskItem {
  id            String                  @id @default(uuid())
  offboardingId String
  offboarding   OffboardingRequest      @relation(fields: [offboardingId], references: [id], onDelete: Cascade)
  category      OffboardingTaskCategory @default(HR_DOCUMENTS)
  title         String
  isCompleted   Boolean                 @default(false)
  completedAt   DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}
enum OkrLevel {
  COMPANY
  DEPARTMENT
  INDIVIDUAL
}

enum OkrStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

model OkrCycle {
  id         String      @id @default(uuid())
  title      String
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  isCurrent  Boolean     @default(false)
  objectives Objective[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Objective {
  id           String      @id @default(uuid())
  cycleId      String
  cycle        OkrCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  level        OkrLevel    @default(INDIVIDUAL)
  title        String
  description  String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  employeeId   String?
  employee     Employee?   @relation(fields: [employeeId], references: [id])
  parentId     String?
  parent       Objective?  @relation("CascadingObjectives", fields: [parentId], references: [id])
  children     Objective[] @relation("CascadingObjectives")
  status       OkrStatus   @default(DRAFT)
  progress     Float       @default(0.0)
  keyResults   KeyResult[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model KeyResult {
  id           String       @id @default(uuid())
  objectiveId  String
  objective    Objective    @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  title        String
  initialValue Float        @default(0.0)
  targetValue  Float
  currentValue Float        @default(0.0)
  unit         String       @default("%")
  progress     Float        @default(0.0)
  checkIns     OkrCheckIn[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model OkrCheckIn {
  id          String    @id @default(uuid())
  keyResultId String
  keyResult   KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  value       Float
  comment     String?
  createdById String
  createdAt   DateTime  @default(now())
}
enum DiscType {
  D // Dominance
  I // Influence
  S // Steadiness
  C // Conscientiousness
}

model DiscQuestion {
  id        String       @id @default(uuid())
  text      String
  order     Int          @default(1)
  options   DiscOption[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model DiscOption {
  id         String       @id @default(uuid())
  questionId String
  question   DiscQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  discType   DiscType
  score      Int          @default(1)
}

model DiscAssessment {
  id            String             @id @default(uuid())
  employeeId    String
  employee      Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dScore        Float              @default(0.0)
  iScore        Float              @default(0.0)
  sScore        Float              @default(0.0)
  cScore        Float              @default(0.0)
  primaryType   DiscType
  secondaryType DiscType?
  responses     DiscUserResponse[]
  createdAt     DateTime           @default(now())
}

model DiscUserResponse {
  id           String         @id @default(uuid())
  assessmentId String
  assessment   DiscAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId   String
  optionId     String
  discType     DiscType
}
enum FeedbackReviewerType {
  SELF
  MANAGER
  PEER
  SUBORDINATE
}

enum FeedbackCycleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

model FeedbackCycle {
  id           String              @id @default(uuid())
  title        String
  description  String?
  startDate    DateTime            @db.Date
  endDate      DateTime            @db.Date
  status       FeedbackCycleStatus @default(DRAFT)
  assignments  FeedbackAssignment[]
  questions    FeedbackQuestion[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model FeedbackQuestion {
  id          String            @id @default(uuid())
  cycleId     String
  cycle       FeedbackCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  competency  String
  text        String
  order       Int               @default(1)
  answers     FeedbackAnswer[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model FeedbackAssignment {
  id          String               @id @default(uuid())
  cycleId     String
  cycle       FeedbackCycle        @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  targetId    String
  target      Employee             @relation("FeedbackTarget", fields: [targetId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    Employee             @relation("FeedbackReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  type        FeedbackReviewerType @default(PEER)
  isCompleted Boolean              @default(false)
  answers     FeedbackAnswer[]
  createdAt   DateTime             @default(now())

  @@unique([cycleId, targetId, reviewerId])
}

model FeedbackAnswer {
  id           String             @id @default(uuid())
  assignmentId String
  assignment   FeedbackAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  questionId   String
  question     FeedbackQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  score        Int                // 1-5 mashtabida
  comment      String?            @db.Text
  createdAt    DateTime           @default(now())

  @@unique([assignmentId, questionId])
}
enum PromotionStatus {
  PENDING
  APPROVED_BY_MANAGER
  APPROVED_BY_HR
  REJECTED
  CANCELLED
}

model JobGrade {
  id              String      @id @default(uuid())
  code            String      @unique // Masalan: "SE-G1", "SE-G2"
  title           String      // Masalan: "Junior Software Engineer", "Middle Software Engineer"
  level           Int         @default(1)
  minSalary       Float
  maxSalary       Float
  requirements    String?     @db.Text
  responsibilities String?    @db.Text
  employees       Employee[]
  promotionTarget PromotionRequest[] @relation("TargetGrade")
  promotionCurrent PromotionRequest[] @relation("CurrentGrade")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model PromotionRequest {
  id               String          @id @default(uuid())
  employeeId       String
  employee         Employee        @relation("EmployeePromotion", fields: [employeeId], references: [id], onDelete: Cascade)
  currentGradeId   String?
  currentGrade     JobGrade?       @relation("CurrentGrade", fields: [currentGradeId], references: [id])
  targetGradeId    String
  targetGrade      JobGrade        @relation("TargetGrade", fields: [targetGradeId], references: [id])
  proposedSalary   Float
  reason           String          @db.Text
  okrScore         Float?          // OKR bajarilish foizi
  feedback360Score Float?          // 360-degree o'rtacha balli
  status           PromotionStatus @default(PENDING)
  managerApproval  Boolean         @default(false)
  hrApproval       Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model CareerHistory {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  oldGradeTitle String?
  newGradeTitle String
  oldSalary     Float?
  newSalary     Float
  changedAt     DateTime  @default(now())
  reason        String?
}
enum NotificationType {
  LEAVE_REQUEST
  LEAVE_APPROVED
  LEAVE_REJECTED
  OKR_ASSIGNED
  OKR_CHECKIN_REMINDER
  COURSE_ASSIGNED
  OFFBOARDING_TASK
  GENERAL
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
}

model UserDeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fcmToken  String   @unique
  deviceOs  String?  // "iOS" yoki "Android"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}